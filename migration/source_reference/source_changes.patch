+    def _print_target_status(self, command):
+        ids = (command.task_type == 1).nonzero().flatten()
+        if not len(ids):
+            return
+        e = int(ids[0])
+        step = int(self.env.common_step_counter)
+        episode = (int(command.command_counter[e]), int(command.goal_sequence[e]))
+        if (episode == self._target_status_episode and self._target_status_step >= 0
