+    @torch.no_grad()
+    def __call__(self, obs):
+        from supermimic.tasks.m1_reward import m1_actor_goal
+        command = self.env.command_manager.get_term("m1_prior_joint")
+        if self.velocity is not None:
+            command.velocity_command_body[:] = command.velocity_command_body.new_tensor(self.velocity)
+            command.velocity_command_body[command.task_type == 1] = 0.
+        if self.target_world is not None:
+            command.target_position_world[:] = command.target_position_world.new_tensor(self.target_world)
+        if "replay" in self.env.recorder_manager.active_terms:
