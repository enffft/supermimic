+        xyz = lambda x: "(" + ", ".join(f"{v:.3f}" for v in x.tolist()) + ")"
+        print(f"[M1 target] env={e} episode={episode} world_xyz={xyz(target)} m "
+              f"TCP_xyz={xyz(tcp)} m error={float((target - tcp).norm()):.3f} m", flush=True)
